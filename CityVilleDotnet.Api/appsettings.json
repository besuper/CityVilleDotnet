{
    "Urls": "http://0.0.0.0:5221",
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "Database": "Server=localhost; Database=CityVille; Integrated Security=True; Application Name=CityVille; TrustServerCertificate=true;"
    },
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.File"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "System.Net.Http.HttpClient": "Warning",
                "Microsoft.AspNetCore": "Warning",
                "Microsoft.AspNetCore.HttpLogging": "Warning",
                "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
                "Microsoft.EntityFrameworkCore.Infrastructure": "Warning",
                "Microsoft.EntityFrameworkCore.Migrations": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "restrictedToMinimumLevel": "Information",
                    "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
                    "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:j}{NewLine}{Exception}"
                }
            },
            {
                "Name": "File",
                "Args": {
                    "restrictedToMinimumLevel": "Information",
                    "path": "./logs/log.txt",
                    "rollingInterval": "Day",
                    "outputTemplate": "{Timestamp:HH:mm:ss} [{Level}] {Message}{NewLine}{Exception}"
                }
            }
        ]
    },
    "enableCheat": true,
    "runtimeVars": {
        "WEATHER": "{\"forecast\":[1,0,0,0,0,0,0]}",
        "CITY_AT_NIGHT_GAME_MODE": 1,

        "MAX_VISIBLE_NPCS": 150,
        "MIN_VISIBLE_NPCS": 10,
        "MAXIMUM_ACTIVE_TAXIS": 5,
        "MAXIMUM_ACTIVE_CARS": 10,

        "SHRINK_RAY_CAP": 100,
        "SUBSCRIPTION_ENABLE_ZDC": 1,
        "BUY_ALL_DISCOUNT_RATE": 0
    },
    "experiments": [
        {"name": "cv_global_leaderboard", "variant": 0},
        {"name": "cv_leader_master", "variant": 0},
        {"name": "cv_multipop_migrate", "variant": 1},
        {"name": "cv_defcon_npc_culling", "variant": 3},
        {"name": "cv_CityatNights_Teaser", "variant": 2},
        {"name": "cv_CityatNights_Priceunlock", "variant": 6},
        {"name": "cv_quest_frame", "variant": 3},
        {"name": "cv_featured_quest_sort", "variant": 3},
        {"name": "cv_hide_even_more_quests", "variant": 3},
        {"name": "cv_questhiding", "variant": 1},
        {"name": "cv_quest_prorated_pricing", "variant": 0},
        {"name": "cv_quest_sale", "variant": 0},
        {"name": "cv_downtown", "variant": 1},
        {"name": "cv_downtown_fullrelease", "variant": 1},
        {"name": "cv_market_3", "variant": 3},
        {"name": "cv_disable_startup_popups", "variant": 1}
    ]
}
