@page
@{
	Layout = "Shared/_GameLayout";
}

@model CityVilleDotnet.Api.Pages.GameModel

@section Header {
	<script type="text/javascript" src="jquery.min.js"></script>
	<script type="text/javascript" src="flash_integration.min.js"></script>
	<script type="text/javascript" src="swfobject.min.js"></script>
	<script>
		document.cookie = "nativeFlash=" + (navigator.plugins && navigator.plugins["Shockwave Flash"] ? "1" : "0") + "; path=/; max-age=31536000; SameSite=Lax";
	</script>
	<script type="text/javascript" src="ruffle/ruffle.js"></script>
}

<div style="width:960px;height:756px;" class="mx-auto">
	<div id="flashOuterContainer">
		<div id="flashContent">
			<object id="flashapp" name="flashapp" width="960" height="756" type="application/x-shockwave-flash"
			        data="Preloader.swf">
				<param name="allowFullScreen" value="true"/>
				<param name="flashvars" value="@Model.BuildFlashVars()"/>
			</object>
		</div>
	</div>
</div>

@if (Model.EnableCheat)
{
	await Html.RenderPartialAsync("_CheatMenu");
}

<script>
	function getUserInfo() {
		console.log("getUserInfo called");

		return {
			"zid": @(Model.Uid),
			"uid": "@(Model.Uid)",
			"first_name": "@Model.UserName",
			"name": "@Model.UserName",
			"sex": "M",
			"pic_square": "@Model.PictureUrl",
			"level": @(Model.Level)
		};
	}

	function getFriendData() {
		console.log("getFriendData called");

		return @Html.Raw(Model.FriendList);
	}

	function getAppFriendIds() {
		console.log("getAppFriendIds called");
		return [];
	}

	function onGameLoaded(seen, popp, canvas) {
		console.log("Game is loaded " + seen + ", " + popp + ", " + canvas);
	}

	function getAssetOverrides() {
		console.log("getAssetOverrides called");
		return {};
	}

	function getRuntimeVars() {
		return @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RuntimeVars));
	}

	function getExperiments() {
		return @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Experiments));
	}

	function getLocaleOverrides() {
		return null;
	}

	function getFlashApp() {
		return document.getElementById('flashapp');
	}

	function sendRequest(a, b, c, d) {
		console.log("sendRequest called: ", a, b, c, d);
	}

	function completeSendRequest(b) {
		console.log("completeSendRequest called:", b)
	}

	ZYFrameManager = {
		"reloadApp": function () {
			console.log("Reload App");
			window.location.reload();
		},
		"navigateTo": function (a, b, c) {
			console.log("Navigate To" + a + " - " + b + " - " + c);
		},
		"openTab": function (a, b, c) {
			console.log("Open Tab" + a + " - " + b + " - " + c);
		},
		"switchToTab": function (a) {
			console.log("Switch To Tab" + a);
		}
	}

	window.RufflePlayer = window.RufflePlayer || {};
	window.RufflePlayer.config = {
		allowScriptAccess: true,
		autoplay: "on",
		unmuteOverlay: "hidden",
		logLevel: "warn",
		polyfills: true,
		allowFullscreen: true,
		wmode: "window",
		deviceFontRenderer: "canvas",
		maxExecutionDuration: 360
	};
</script>
