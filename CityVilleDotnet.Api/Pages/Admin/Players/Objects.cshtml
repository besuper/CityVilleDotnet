@page "{id:guid}"
@using CityVilleDotnet.Domain.Enums
@model CityVilleDotnet.Api.Pages.Admin.Players.ObjectsModel

<div class="d-flex align-items-center justify-content-between flex-wrap mb-4">
	<h4 class="font-outfit font-weight-bold text-dark mb-0">
		<i class="bi bi-buildings mr-2 text-primary"></i>@Localizer["Objects"] · @Model.Username
		<span class="badge badge-primary ml-1">@Model.TotalCount</span>
	</h4>
	<a asp-page="/Admin/Players/Edit" asp-route-id="@Model.PlayerId" asp-fragment="worlds" class="btn btn-outline-secondary btn-sm">
		<i class="bi bi-arrow-left mr-1"></i>@Model.Username
	</a>
</div>

<div class="card border-0 shadow-sm mb-4">
	<div class="card-body">
		<form method="get" class="form-row">
			<div class="col-12 col-md-3 mb-2">
				<select class="custom-select" name="SelectedWorld" onchange="this.form.submit()">
					@foreach (var world in Model.AvailableWorlds)
					{
						<option value="@world" selected="@(world == Model.SelectedWorld)">@world</option>
					}
				</select>
			</div>
			<div class="col-12 col-md-9 mb-2">
				<div class="input-group">
					<input type="text" class="form-control" name="Search" value="@Model.Search" maxlength="64" placeholder="@Localizer["ItemName"]"/>
					<div class="input-group-append">
						<button type="submit" class="btn btn-primary font-weight-bold"><i class="bi bi-search mr-1"></i>@Localizer["Search"]</button>
					</div>
				</div>
			</div>
		</form>
	</div>
</div>

<div class="card border-0 shadow-sm">
	<div class="card-body">
		@if (Model.Objects.Any())
		{
			<div class="table-responsive">
				<table class="table table-hover table-sm mb-0">
					<thead>
					<tr>
						<th>Id</th>
						<th>@Localizer["ItemName"]</th>
						<th>@Localizer["Class"]</th>
						<th>@Localizer["State"]</th>
						<th>X</th>
						<th>Y</th>
						<th>Z</th>
						<th>@Localizer["Direction"]</th>
						<th></th>
					</tr>
					</thead>
					<tbody>
					@foreach (var obj in Model.Objects)
					{
						<tr>
							<td class="align-middle small">@obj.WorldFlatId</td>
							<td class="align-middle text-monospace small">@obj.ItemName</td>
							<td class="align-middle small">@obj.ClassName</td>
							<td class="align-middle small">@obj.State</td>
							<td class="align-middle small">@obj.X</td>
							<td class="align-middle small">@obj.Y</td>
							<td class="align-middle small">@obj.Z</td>
							<td class="align-middle small">@obj.Direction</td>
							<td class="text-right text-nowrap">
								<button type="button" class="btn btn-sm btn-outline-primary cv-edit-object" data-toggle="modal" data-target="#editObjectModal"
								        data-id="@obj.WorldFlatId" data-item="@obj.ItemName" data-class="@obj.ClassName" data-state="@obj.State"
								        data-x="@obj.X" data-y="@obj.Y" data-z="@obj.Z" data-direction="@obj.Direction" title="@Localizer["Edit"]">
									<i class="bi bi-pencil"></i>
								</button>
								<form method="post" asp-page-handler="DeleteObject" asp-route-id="@Model.PlayerId" class="d-inline" data-confirm="@Localizer["AdminDeleteConfirm"]">
									<input type="hidden" name="SelectedWorld" value="@Model.SelectedWorld"/>
									<input type="hidden" name="Search" value="@Model.Search"/>
									<input type="hidden" name="CurrentPage" value="@Model.CurrentPage"/>
									<input type="hidden" name="worldFlatId" value="@obj.WorldFlatId"/>
									<button type="submit" class="btn btn-sm btn-outline-danger" title="@Localizer["Delete"]"><i class="bi bi-trash"></i></button>
								</form>
							</td>
						</tr>
					}
					</tbody>
				</table>
			</div>

			@if (Model.TotalPages > 1)
			{
				<nav class="mt-3">
					<ul class="pagination pagination-sm justify-content-center mb-0">
						<li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
							<a class="page-link" asp-page="/Admin/Players/Objects" asp-route-id="@Model.PlayerId" asp-route-SelectedWorld="@Model.SelectedWorld" asp-route-Search="@Model.Search" asp-route-CurrentPage="@(Model.CurrentPage - 1)"><i class="bi bi-chevron-left"></i></a>
						</li>
						<li class="page-item disabled"><span class="page-link">@Model.CurrentPage / @Model.TotalPages</span></li>
						<li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
							<a class="page-link" asp-page="/Admin/Players/Objects" asp-route-id="@Model.PlayerId" asp-route-SelectedWorld="@Model.SelectedWorld" asp-route-Search="@Model.Search" asp-route-CurrentPage="@(Model.CurrentPage + 1)"><i class="bi bi-chevron-right"></i></a>
						</li>
					</ul>
				</nav>
			}
		}
		else
		{
			<p class="text-muted mb-0">@Localizer["NoResults"]</p>
		}
	</div>
</div>

<div class="modal fade" id="editObjectModal" tabindex="-1" role="dialog" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered" role="document">
		<form method="post" asp-page-handler="UpdateObject" asp-route-id="@Model.PlayerId" class="modal-content border-0 shadow">
			<div class="modal-header">
				<h5 class="modal-title font-weight-bold">@Localizer["Edit"] #<span id="editObjectTitle"></span></h5>
				<button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
			</div>
			<div class="modal-body">
				<input type="hidden" name="SelectedWorld" value="@Model.SelectedWorld"/>
				<input type="hidden" name="Search" value="@Model.Search"/>
				<input type="hidden" name="CurrentPage" value="@Model.CurrentPage"/>
				<input type="hidden" name="input.WorldFlatId" id="editObjectId"/>

				<div class="form-group">
					<label class="small font-weight-bold" for="editObjectItem">@Localizer["ItemName"]</label>
					<input type="text" class="form-control" name="input.ItemName" id="editObjectItem" maxlength="64" required/>
				</div>
				<div class="form-row">
					<div class="form-group col-6">
						<label class="small font-weight-bold" for="editObjectClass">@Localizer["Class"]</label>
						<select class="custom-select" name="input.ClassName" id="editObjectClass">
							@foreach (var className in Enum.GetValues<BuildingClassType>())
							{
								<option value="@className">@className</option>
							}
						</select>
					</div>
					<div class="form-group col-6">
						<label class="small font-weight-bold" for="editObjectState">@Localizer["State"]</label>
						<select class="custom-select" name="input.State" id="editObjectState">
							@foreach (var state in Enum.GetValues<WorldObjectState>())
							{
								<option value="@state">@state</option>
							}
						</select>
					</div>
				</div>
				<div class="form-row">
					<div class="form-group col-3">
						<label class="small font-weight-bold" for="editObjectX">X</label>
						<input type="number" class="form-control" name="input.X" id="editObjectX" required/>
					</div>
					<div class="form-group col-3">
						<label class="small font-weight-bold" for="editObjectY">Y</label>
						<input type="number" class="form-control" name="input.Y" id="editObjectY" required/>
					</div>
					<div class="form-group col-3">
						<label class="small font-weight-bold" for="editObjectZ">Z</label>
						<input type="number" class="form-control" name="input.Z" id="editObjectZ"/>
					</div>
					<div class="form-group col-3">
						<label class="small font-weight-bold" for="editObjectDirection">@Localizer["Direction"]</label>
						<input type="number" class="form-control" name="input.Direction" id="editObjectDirection" min="0" max="3" required/>
					</div>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-outline-secondary" data-dismiss="modal">@Localizer["Cancel"]</button>
				<button type="submit" class="btn btn-primary font-weight-bold"><i class="bi bi-save mr-1"></i>@Localizer["Save"]</button>
			</div>
		</form>
	</div>
</div>

@section Scripts {
	<script>
		document.addEventListener("DOMContentLoaded", () => {
			document.querySelectorAll('.cv-edit-object').forEach(button => {
				button.addEventListener('click', () => {
					const data = button.dataset;

					document.getElementById('editObjectTitle').textContent = data.id;
					document.getElementById('editObjectId').value = data.id;
					document.getElementById('editObjectItem').value = data.item;
					document.getElementById('editObjectClass').value = data.class;
					document.getElementById('editObjectState').value = data.state;
					document.getElementById('editObjectX').value = data.x;
					document.getElementById('editObjectY').value = data.y;
					document.getElementById('editObjectZ').value = data.z;
					document.getElementById('editObjectDirection').value = data.direction;
				});
			});
		});
	</script>
}
