@page
@model CityVilleDotnet.Api.Pages.Admin.Players.IndexModel

<h4 class="font-outfit font-weight-bold text-dark mb-4">
	<i class="bi bi-people-fill mr-2 text-primary"></i>@Localizer["Players"]
	<span class="badge badge-primary ml-1">@Model.TotalCount</span>
</h4>

<div class="card border-0 shadow-sm mb-4">
	<div class="card-body">
		<form method="get">
			<div class="input-group">
				<input type="text" class="form-control" name="Search" value="@Model.Search" maxlength="32" placeholder="@Localizer["SearchPlayer"]"/>
				<div class="input-group-append">
					<button type="submit" class="btn btn-primary font-weight-bold">
						<i class="bi bi-search mr-1"></i>@Localizer["Search"]
					</button>
				</div>
			</div>
		</form>
	</div>
</div>

<div class="card border-0 shadow-sm">
	<div class="card-body">
		@if (Model.Players.Any())
		{
			<div class="table-responsive">
				<table class="table table-hover table-sm mb-0">
					<thead>
					<tr>
						<th>@Localizer["Username"]</th>
						<th>Snuid</th>
						<th>@Localizer["Level"]</th>
						<th>@Localizer["Gold"]</th>
						<th>@Localizer["Cash"]</th>
						<th>@Localizer["MemberSince"]</th>
						<th>@Localizer["LastActivity"]</th>
					</tr>
					</thead>
					<tbody>
					@foreach (var player in Model.Players)
					{
						<tr>
							<td>
								<a asp-page="/Admin/Players/Edit" asp-route-id="@player.Id" class="font-weight-bold">
									<img src="@(player.ProfilePictureUrl ?? "/blank.png")" alt="" class="rounded mr-2" style="width:24px;height:24px;"/>@player.Username
								</a>
								@if (player.IsAdmin)
								{
									<span class="badge badge-danger ml-1">@Localizer["Admin"]</span>
								}
							</td>
							<td>@player.Snuid</td>
							<td>@player.Level</td>
							<td>@player.Gold.ToString("N0")</td>
							<td>@player.Cash.ToString("N0")</td>
							<td>@player.CreationTimestamp.ToString("dd/MM/yyyy")</td>
							<td>
								@if (player.LastTrackingTimestamp >= Model.OnlineThreshold)
								{
									<span class="badge badge-success">@Localizer["Online"]</span>
								}
								else if (player.LastTrackingTimestamp > DateTimeOffset.MinValue)
								{
									<span class="text-muted">@player.LastTrackingTimestamp.ToString("dd/MM/yyyy HH:mm")</span>
								}
							</td>
						</tr>
					}
					</tbody>
				</table>
			</div>

			@if (Model.TotalPages > 1)
			{
				<nav class="mt-3">
					<ul class="pagination pagination-sm justify-content-center mb-0">
						<li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
							<a class="page-link" asp-page="/Admin/Players/Index" asp-route-Search="@Model.Search" asp-route-CurrentPage="@(Model.CurrentPage - 1)"><i class="bi bi-chevron-left"></i></a>
						</li>
						<li class="page-item disabled"><span class="page-link">@Model.CurrentPage / @Model.TotalPages</span></li>
						<li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
							<a class="page-link" asp-page="/Admin/Players/Index" asp-route-Search="@Model.Search" asp-route-CurrentPage="@(Model.CurrentPage + 1)"><i class="bi bi-chevron-right"></i></a>
						</li>
					</ul>
				</nav>
			}
		}
		else
		{
			<p class="text-muted mb-0">@Localizer["NoResults"]</p>
		}
	</div>
</div>
