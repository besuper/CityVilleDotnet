@page
@using CityVilleDotnet.Api.Common.Logging
@model CityVilleDotnet.Api.Pages.Admin.LogsModel

@{
	const int previewLength = 400;
}

<h4 class="font-outfit font-weight-bold text-dark mb-4">
	<i class="bi bi-journal-text mr-2 text-primary"></i>@Localizer["Logs"]
</h4>

<div class="card border-0 shadow-sm mb-4">
	<div class="card-body">
		<form method="get" class="form-row">
			<div class="col-12 col-md-3 mb-2">
				<select class="custom-select" name="SelectedFile">
					<option value="@LogsModel.AllFiles" selected="@(Model.SelectedFile == LogsModel.AllFiles)">@Localizer["AllFiles"]</option>
					@foreach (var file in Model.Files)
					{
						<option value="@file" selected="@(file == Model.SelectedFile)">@file</option>
					}
				</select>
			</div>
			<div class="col-12 col-md-2 mb-2">
				<select class="custom-select" name="Level">
					<option value="">@Localizer["AllLevels"]</option>
					@foreach (var level in LogsModel.Levels)
					{
						<option value="@level" selected="@(level == Model.Level)">@level</option>
					}
				</select>
			</div>
			<div class="col-12 col-md-7 mb-2">
				<div class="input-group">
					<input type="text" class="form-control" name="Search" value="@Model.Search" maxlength="256" placeholder="@Localizer["SearchLogs"]"/>
					<div class="input-group-append">
						<button type="submit" class="btn btn-primary font-weight-bold"><i class="bi bi-search mr-1"></i>@Localizer["Search"]</button>
					</div>
				</div>
			</div>
		</form>
	</div>
</div>

<div class="card border-0 shadow-sm">
	<div class="card-body">
		<div class="d-flex align-items-center justify-content-between mb-3">
			<span class="font-weight-bold text-dark">
				@Model.TotalCount.ToString("N0") @Localizer["Results"]
			</span>
			@if (Model.Truncated)
			{
				<span class="text-warning small"><i class="bi bi-exclamation-triangle mr-1"></i>@Localizer["LogsTruncated", LogFileReader.MaxResults]</span>
			}
		</div>

		@if (Model.Entries.Any())
		{
			<div class="table-responsive">
				<table class="table table-sm table-hover mb-0">
					<tbody>
					@foreach (var entry in Model.Entries)
					{
						<tr>
							<td class="text-nowrap small text-muted" style="width:1%">
								@(entry.Date?.ToString("dd/MM/yyyy")) @entry.Time
							</td>
							<td style="width:1%"><span class="badge @LogsModel.GetLevelBadge(entry.Level)">@entry.Level</span></td>
							<td class="small">
								@if (entry.Message.Length > previewLength)
								{
									<details>
										<summary class="text-monospace text-break">@(entry.Message[..previewLength])…</summary>
										<pre class="small text-break mb-0 mt-1" style="white-space:pre-wrap">@entry.Message</pre>
									</details>
								}
								else
								{
									<pre class="small text-break mb-0" style="white-space:pre-wrap">@entry.Message</pre>
								}
							</td>
						</tr>
					}
					</tbody>
				</table>
			</div>

			@if (Model.TotalPages > 1)
			{
				<nav class="mt-3">
					<ul class="pagination pagination-sm justify-content-center mb-0">
						<li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
							<a class="page-link" asp-page="/Admin/Logs" asp-route-SelectedFile="@Model.SelectedFile" asp-route-Level="@Model.Level" asp-route-Search="@Model.Search" asp-route-CurrentPage="@(Model.CurrentPage - 1)"><i class="bi bi-chevron-left"></i></a>
						</li>
						<li class="page-item disabled"><span class="page-link">@Model.CurrentPage / @Model.TotalPages</span></li>
						<li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
							<a class="page-link" asp-page="/Admin/Logs" asp-route-SelectedFile="@Model.SelectedFile" asp-route-Level="@Model.Level" asp-route-Search="@Model.Search" asp-route-CurrentPage="@(Model.CurrentPage + 1)"><i class="bi bi-chevron-right"></i></a>
						</li>
					</ul>
				</nav>
			}
		}
		else
		{
			<p class="text-muted mb-0">@Localizer["NoResults"]</p>
		}
	</div>
</div>
