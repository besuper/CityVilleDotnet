@page
@inject Microsoft.Extensions.Localization.IStringLocalizer<Resources.SharedResource> Localizer
@model CityVilleDotnet.Api.Pages.Account.LoginModel

<div class="d-flex align-items-center justify-content-center min-vh-100 bg-light px-3">
    <div class="card shadow-sm" style="max-width: 400px; width: 100%;">
        <div class="card-header text-center">
            <h2 class="mb-0">@Localizer["Login_"]</h2>
        </div>
        <div class="card-body">
            @{
                var showPasswordForm = !Model.DiscordEnabled || Request.Method == "POST";
            }

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            @if (Model.DiscordEnabled)
            {
                <form asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="mb-3">
                    <button type="submit" class="w-100 btn btn-lg text-white" style="background-color: #5865F2;">
                        <i class="bi bi-discord me-2"></i>@Localizer["ContinueWithDiscord"]
                    </button>
                </form>
                <button type="button" class="w-100 btn btn-link text-muted small text-decoration-none mb-2" data-bs-toggle="collapse" data-bs-target="#passwordForm" aria-expanded="@(showPasswordForm ? "true" : "false")" aria-controls="passwordForm">
                    @Localizer["OrUsePassword"] <i class="bi bi-chevron-down"></i>
                </button>
            }

            <div class="collapse@(showPasswordForm ? " show" : "")" id="passwordForm">
                <form id="account" method="post" novalidate>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Username" type="text" class="form-control" id="floatingUsername"
                               placeholder="Username" autocomplete="username" aria-required="true"/>
                        <label for="floatingUsername">@Html.DisplayNameFor(m => m.Input.Username)</label>
                        <span asp-validation-for="Input.Username" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" type="password" class="form-control" id="floatingPassword"
                               placeholder="Password" autocomplete="current-password" aria-required="true"/>
                        <label for="floatingPassword">@Html.DisplayNameFor(m => m.Input.Password)</label>
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" asp-for="Input.RememberMe" id="rememberMe"/>
                        <label class="form-check-label" for="rememberMe">
                            @Html.DisplayNameFor(m => m.Input.RememberMe)
                        </label>
                    </div>

                    <button id="login-submit" type="submit" class="w-100 btn btn-primary btn-lg">
                        @Localizer["Login_"]
                    </button>
                </form>
            </div>

            <div class="mt-3 text-center">
                <p>
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none">
                        @Localizer["Register"]
                    </a>
                </p>
            </div>
        </div>
    </div>
</div>
