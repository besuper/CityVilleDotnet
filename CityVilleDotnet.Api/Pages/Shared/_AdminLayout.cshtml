@using System.Reflection
@inject Microsoft.Extensions.Localization.IStringLocalizer<Resources.SharedResource> Localizer

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>CityVilleDotnet - @Localizer["AdminPanel"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-xOolHFLEh07PJGoPkLv1IbcEPTNtaed2xpHsD9ESMhqIYd0nLMwNLD69Npy4HI+N" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">

    <link type="text/css" rel="stylesheet" href="~/css/site.css"/>

    @await RenderSectionAsync("Header", required: false)
</head>
<body class="bg-light d-flex flex-column min-vh-100">
<nav class="navbar navbar-expand-lg cv-navbar sticky-top border-bottom bg-white">
    <div class="container-fluid px-lg-5">
        <a class="d-flex align-items-center text-decoration-none py-2" asp-page="/Admin/Index">
            <span class="font-outfit font-weight-bold h5 text-dark mb-0">CityVille<span class="text-primary">.NET</span></span>
            <span class="badge badge-danger ml-2">@Localizer["Admin"]</span>
        </a>

        <button class="navbar-toggler border-secondary rounded" type="button" data-toggle="collapse" data-target="#cvAdminNavbar">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="cvAdminNavbar">
            <ul class="navbar-nav mr-auto ml-lg-4">
                <li class="nav-item">
                    <a class="nav-link text-secondary font-weight-bold d-flex align-items-center rounded px-3 py-2 my-2 mx-1 cv-hover" asp-page="/Admin/Index">
                        <i class="bi bi-speedometer2 mr-2"></i>@Localizer["Dashboard"]
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-secondary font-weight-bold d-flex align-items-center rounded px-3 py-2 my-2 mx-1 cv-hover" asp-page="/Admin/Players/Index">
                        <i class="bi bi-people mr-2"></i>@Localizer["Players"]
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-secondary font-weight-bold d-flex align-items-center rounded px-3 py-2 my-2 mx-1 cv-hover" asp-page="/Admin/Logs">
                        <i class="bi bi-journal-text mr-2"></i>@Localizer["Logs"]
                    </a>
                </li>
            </ul>

            <a class="btn btn-outline-primary btn-sm font-weight-bold" asp-page="/Game">
                <i class="bi bi-play-fill mr-1"></i>@Localizer["BackToGame"]
            </a>
        </div>
    </div>
</nav>

<div class="container-fluid px-lg-5 py-4 flex-grow-1">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger fade show d-flex align-items-center justify-content-between" role="alert">
            <span><i class="bi bi-exclamation-triangle-fill mr-2"></i>@TempData["Error"]</span>
            <button type="button" class="btn btn-sm ml-3" data-dismiss="alert"><i class="bi bi-x-lg"></i></button>
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success fade show d-flex align-items-center justify-content-between" role="alert">
            <span><i class="bi bi-check-circle-fill mr-2"></i>@TempData["Success"]</span>
            <button type="button" class="btn btn-sm ml-3" data-dismiss="alert"><i class="bi bi-x-lg"></i></button>
        </div>
    }

    @RenderBody()
</div>

<footer class="mt-auto">
    <div style="max-width:760px; margin: 0 auto;">
        <hr class="my-2">
        <p class="text-center text-muted small mb-3">
            CityVilleDotnet
            build: @(Assembly.GetEntryAssembly()?.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion ?? "dev")
        </p>
    </div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.slim.min.js"
        integrity="sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj"
        crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-Fy6S3B9q64WdZWQUiU+q4/2Lc9npb8tCaSX9FK7E8HnRr0Jz8D6OP9dO5Vg3Q9ct"
        crossorigin="anonymous"></script>
<script>
    document.addEventListener("submit", e => {
        const message = e.target.dataset?.confirm;

        if (message && !confirm(message)) e.preventDefault();
    });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
