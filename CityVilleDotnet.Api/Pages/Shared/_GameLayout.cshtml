@using System.Reflection
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>CityVilleDotnet</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-xOolHFLEh07PJGoPkLv1IbcEPTNtaed2xpHsD9ESMhqIYd0nLMwNLD69Npy4HI+N" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">

    <link type="text/css" rel="stylesheet" href="~/css/site.css"/>

    @await RenderSectionAsync("Header", required: false)
</head>
<body class="bg-light d-flex flex-column min-vh-100">
<nav class="navbar navbar-expand-lg cv-navbar sticky-top border-bottom bg-white">
    <div class="container">
        <a class="d-flex align-items-center text-decoration-none py-2" href="#">
            <span class="font-outfit font-weight-bold h5 text-dark">CityVille<span class="text-primary">.NET</span></span>
        </a>

        <button class="navbar-toggler border-secondary rounded" type="button" data-toggle="collapse" data-target="#cvNavbar">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="cvNavbar">
            <ul class="navbar-nav mr-auto ml-lg-4">
                <li class="nav-item">
                    <a class="nav-link text-secondary font-weight-bold d-flex align-items-center rounded px-3 py-2 my-2 mx-1 cv-hover"
                       asp-page="/Game" title="Game">
                        <i class="bi bi-play-fill mr-2"></i>
                        Play
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-secondary font-weight-bold d-flex align-items-center rounded px-3 py-2 my-2 mx-1 cv-hover"
                       asp-page="/Friends/List" title="Friends">
                        <i class="bi bi-people mr-2"></i>
                        Friends
                    </a>
                </li>
            </ul>

            <div class="dropdown">
                <div class="d-flex align-items-center p-2 rounded cv-hover" role="button"
                     data-toggle="dropdown" aria-expanded="false">
                    <img class="rounded mr-2" src="/blank.png" alt="Profile"/>
                    <div class="d-none d-lg-block">
                        <div class="font-weight-bold text-dark" style="font-size:0.875rem;line-height:1.2;">@ViewData["PlayerName"]</div>
                        <div class="text-info" style="font-size:0.7rem;"><i class="bi bi-star-fill"></i> Level @ViewData["PlayerLevel"]
                        </div>
                    </div>
                    <svg class="cv-chevron d-none d-lg-block text-secondary ml-2" xmlns="http://www.w3.org/2000/svg"
                         width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                        <path
                            d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z"/>
                    </svg>
                </div>
                <ul class="dropdown-menu dropdown-menu-right shadow-lg border rounded p-2 mt-2">
                    <li>
                        <a class="dropdown-item d-flex align-items-center rounded py-2 px-3 text-secondary"
                           href="#">
                            <svg class="mr-2" width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor"
                                 stroke-width="1.4" stroke-linecap="round">
                                <circle cx="8" cy="5" r="3"/>
                                <path d="M2 15c0-3 2.5-5 6-5s6 2 6 5"/>
                            </svg>
                            Profile
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item d-flex align-items-center rounded py-2 px-3 text-secondary"
                           href="#">
                            <svg class="mr-2" width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor"
                                 stroke-width="1.4" stroke-linecap="round">
                                <circle cx="8" cy="8" r="2.5"/>
                                <path
                                    d="M8 1v2M8 13v2M1 8h2M13 8h2M2.9 2.9l1.4 1.4M11.7 11.7l1.4 1.4M13.1 2.9l-1.4 1.4M4.3 11.7l-1.4 1.4"/>
                            </svg>
                            Settings
                        </a>
                    </li>
                    <li>
                        <hr class="dropdown-divider my-1 mx-3">
                    </li>
                    <li>
                        <a class="dropdown-item d-flex align-items-center rounded py-2 px-3 text-danger"
                           asp-page="/Account/Logout" title="Logout">
                            <svg class="mr-2" width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor"
                                 stroke-width="1.4" stroke-linecap="round">
                                <path d="M6 2H3a1 1 0 00-1 1v10a1 1 0 001 1h3M11 11l3-3-3-3M6 8h8"/>
                            </svg>
                            Logout
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</nav>

<div class="container py-4 flex-grow-1">
    <div class="d-flex justify-content-center">
        <div>
            @RenderBody()
        </div>
    </div>
</div>

<footer class="mt-auto">
    <div style="max-width:760px; margin: 0 auto;">
        <hr class="my-2">
        <p class="text-center text-muted mb-3" style="font-size:0.75rem;">
            CityVilleDotnet build: @(Assembly.GetEntryAssembly()?.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion.Split('+')[0] ?? "dev")
        </p>
    </div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.slim.min.js"
        integrity="sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-Fy6S3B9q64WdZWQUiU+q4/2Lc9npb8tCaSX9FK7E8HnRr0Jz8D6OP9dO5Vg3Q9ct" crossorigin="anonymous"></script>
</body>
</html>