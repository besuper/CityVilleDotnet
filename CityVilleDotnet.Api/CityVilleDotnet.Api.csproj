<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<StaticWebAssetsCacheDefineStaticWebAssetsEnabled>false</StaticWebAssetsCacheDefineStaticWebAssetsEnabled>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="FastEndpoints" Version="8.1.0" />
		<PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
		<PackageReference Include="Humanizer.Core" Version="3.0.10" />
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.8" />
		<PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
		<PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.7" />
		<PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.7" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.8" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.8" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.8" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="wwwroot\" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\CityVilleDotnet.Common\CityVilleDotnet.Common.csproj" />
	  <ProjectReference Include="..\CityVilleDotnet.Domain\CityVilleDotnet.Domain.csproj" />
	  <ProjectReference Include="..\CityVilleDotnet.Persistence\CityVilleDotnet.Persistence.csproj" />
	  <ProjectReference Include="..\FluorineFX\FluorineFX.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Pages\Account\Login.cshtml.model.cs">
	    <DependentUpon>Login.cshtml</DependentUpon>
	  </Compile>
	  <Compile Update="Pages\Account\Register.cshtml.model.cs">
	    <DependentUpon>Register.cshtml</DependentUpon>
	  </Compile>
	  <Compile Update="Resources\SharedResource.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>SharedResource.resx</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
		<Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
		<Content Update="wwwroot\*.xml" CopyToPublishDirectory="Never" />
		<Content Update="wwwroot\flash_integration.min.js" CopyToPublishDirectory="Never" />
		<Content Update="wwwroot\swfobject.min.js" CopyToPublishDirectory="Never" />
		<Content Update="wwwroot\ZYFrameManager.min.js" CopyToPublishDirectory="Never" />
		<Content Update="wwwroot\**\*.swf" CopyToPublishDirectory="Never" />

		<Content Update="wwwroot\assets\**\*" CopyToPublishDirectory="Never" />
		<Content Update="wwwroot\assets\default.png" CopyToPublishDirectory="PreserveNewest" />
		<Content Update="wwwroot\assets\default.css" CopyToPublishDirectory="PreserveNewest" />
		<Content Update="wwwroot\assets\default.mp3" CopyToPublishDirectory="PreserveNewest" />
		<Content Update="wwwroot\zcache\ZCache.swf" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Update="Resources\SharedResource.resx">
	    <Generator>PublicResXFileCodeGenerator</Generator>
	    <LastGenOutput>SharedResource.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	</ItemGroup>

</Project>
